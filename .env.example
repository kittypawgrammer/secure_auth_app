# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/secure_auth_db?schema=public"

# JWT Secret Key (Minimum 32 bytes recommended for HS256)
# Generate a secure secret using: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="your-secure-random-jwt-secret-key-placeholder"

# Environment Mode
NODE_ENV="development"

# Optional Initial Admin Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123456"
